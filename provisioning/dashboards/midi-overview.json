{
  "annotations": { "list": [] },
  "description": "Live MIDI input — raw messages, active notes, piano timeline and drum hits.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "tskarhed-midi-datasource", "uid": "midi-datasource" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Timestamp" },
            "properties": [{ "id": "unit", "value": "dateTimeAsLocal" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "tskarhed-midi-datasource", "uid": "midi-datasource" },
          "deviceId": "${device}",
          "mode": "raw",
          "noteRangeAuto": false,
          "noteRangeMax": 84,
          "noteRangeMin": 36,
          "refId": "A"
        }
      ],
      "title": "Raw MIDI Messages",
      "type": "table"
    },
    {
      "datasource": { "type": "tskarhed-midi-datasource", "uid": "midi-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlYlRd" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "gauge", "mode": "gradient", "valueDisplayMode": "text" },
            "inspect": false
          },
          "min": 0,
          "max": 127
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "NoteNumber" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "auto" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "NoteName" },
            "properties": [
              { "id": "custom.width", "value": 70 },
              { "id": "custom.cellOptions", "value": { "type": "auto" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "tskarhed-midi-datasource", "uid": "midi-datasource" },
          "deviceId": "${device}",
          "mode": "notes",
          "noteRangeAuto": false,
          "noteRangeMax": 84,
          "noteRangeMin": 36,
          "refId": "A"
        }
      ],
      "title": "Active Notes",
      "type": "table"
    },
    {
      "datasource": { "type": "tskarhed-midi-datasource", "uid": "midi-datasource" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 70, "lineWidth": 1, "spanNulls": false },
          "color": { "mode": "continuous-BlYlRd" }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "mergeValues": false,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "tskarhed-midi-datasource", "uid": "midi-datasource" },
          "deviceId": "${device}",
          "mode": "timeline",
          "noteRangeAuto": true,
          "noteRangeMax": 84,
          "noteRangeMin": 36,
          "refId": "A"
        }
      ],
      "title": "Piano Timeline",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": ["NoteName"],
            "keepFields": false,
            "naming": { "asLabels": false }
          }
        }
      ],
      "type": "state-timeline"
    },
    {
      "datasource": { "type": "tskarhed-midi-datasource", "uid": "midi-datasource" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Active" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "green", "value": 1 }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": { "text": "●", "index": 0 },
                      "false": { "text": "", "index": 1 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Velocity" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "gradient", "valueDisplayMode": "text" }
              },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 127 },
              { "id": "color", "value": { "mode": "continuous-BlYlRd" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "NoteNumber" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "tskarhed-midi-datasource", "uid": "midi-datasource" },
          "deviceId": "${device}",
          "mode": "drums",
          "noteRangeAuto": false,
          "noteRangeMax": 84,
          "noteRangeMin": 36,
          "refId": "A"
        }
      ],
      "title": "Drum Hits (GM1)",
      "type": "table"
    }
  ],
